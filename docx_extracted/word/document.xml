5A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>When you use the Service, we may collect the following types of information:</w:t></w:r></w:p><w:p w14:paraId="1BBEC6A1" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>a. Information You Provide</w:t></w:r></w:p><w:p w14:paraId="00D6DB85" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Account Information:</w:t></w:r><w:r><w:t xml:space="preserve"> Email address, username, password, and contact number when you register.</w:t></w:r></w:p><w:p w14:paraId="4DB0264D" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>User Content:</w:t></w:r><w:r><w:t xml:space="preserve"> Prices, promotions, and other submissions you voluntarily post on the app.</w:t></w:r></w:p><w:p w14:paraId="79BA3F86" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Pictures: </w:t></w:r><w:r><w:t>You may grant us permission to access your device's camera and photo library to submit user-generated images. We collect and store these pictures as part of your user submissions and to facilitate the features you request.</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="7923DE07" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>b. Information We Collect Automatically</w:t></w:r></w:p><w:p w14:paraId="7009B78A" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>Usage Data:</w:t></w:r><w:r><w:t xml:space="preserve"> Items you view, track, or report with the app itself; frequency and patterns of app use.</w:t></w:r></w:p><w:p w14:paraId="3FD312DB" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Device Information:</w:t></w:r><w:r><w:t xml:space="preserve"> Basic technical details such as device type, operating system, and app version.</w:t></w:r></w:p><w:p w14:paraId="1F8740CA" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Log Data:</w:t></w:r><w:r><w:t xml:space="preserve">  Access times, and interactions with app features.</w:t></w:r></w:p><w:p w14:paraId="22CD4812" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Users Location: </w:t></w:r><w:r><w:t xml:space="preserve">Location is collected automatically via GPS, IP address, or sensor data </w:t></w:r><w:r><w:t>when the app is in use to provide location-based features and content recommendations.</w:t></w:r></w:p><w:p w14:paraId="3852A757" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="006421FA"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="55EA9569" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>2. How We Use Your Information</w:t></w:r></w:p><w:p w14:paraId="2372D110" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>We use the information we collect to:</w:t></w:r></w:p><w:p w14:paraId="06CB0638" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Provide and maintain your account and the core functionality of the Service.</w:t></w:r></w:p><w:p w14:paraId="35BA36AF" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Deliver location-based content recommendations tailored to your geographic area to suggest relevant products, deals, or services near you.</w:t></w:r></w:p><w:p w14:paraId="43D0B516" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Improve, personalize, and optimize the app experience based on your location and usage patterns.</w:t></w:r></w:p><w:p w14:paraId="38BFDAD8" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Process and display user-submitted pictures within the app and associated features.</w:t></w:r></w:p><w:p w14:paraId="333B5FBE" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Analyze aggregate usage trends to understand how users interact with products.</w:t></w:r></w:p><w:p w14:paraId="07D4DC9C" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Monitor for fraud, abuse, and technical issues.</w:t></w:r></w:p><w:p w14:paraId="0C200552" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>Communicate with you about your account, updates, or important service notices.</w:t></w:r></w:p><w:p w14:paraId="4378DA8E" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Share aggregated, anonymized insights about product trends with third parties (e.g., retailers, partners, market analysts).</w:t></w:r></w:p><w:p w14:paraId="0E65432B" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="006421FA"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="5DCE8A55" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>3. Location Data &amp; Privacy</w:t></w:r></w:p><w:p w14:paraId="579DC42E" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>a.</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Location Collection &amp; Use</w:t></w:r></w:p><w:p w14:paraId="5A7C08BA" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>We collect your precise or approximate location to:</w:t></w:r></w:p><w:p w14:paraId="6367B69D" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Suggest relevant local content, deals, and recommendations.</w:t></w:r></w:p><w:p w14:paraId="1CD58638" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Help you discover nearby products and services.</w:t></w:r></w:p><w:p w14:paraId="468ADC5F" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="6"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Improve the accuracy of our personalization features.</w:t></w:r></w:p><w:p w14:paraId="58351408" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>b.</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Location Permissions</w:t></w:r></w:p><w:p w14:paraId="074E69DA" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Your device will prompt you to grant location permissions when you first use location-dependent features. You can adjust location permissions at any time through your device's settings. If you disable location services, location-based recommendations will be unavailable, but other app features will continue to function.</w:t></w:r></w:p><w:p w14:paraId="663F75BB" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>c.</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Location Data Retention</w:t></w:r></w:p><w:p w14:paraId="2B948736" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:lastRenderedPageBreak/><w:t xml:space="preserve">We retain location history data only for as long as necessary to provide location-based recommendations and analytics. Historical location data is automatically deleted after </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>180 days</w:t></w:r><w:r><w:t>.</w:t></w:r></w:p><w:p w14:paraId="7C13FB41" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="006421FA"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="259AE83F" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>4. Camera &amp; Photo Submission Privacy</w:t></w:r></w:p><w:p w14:paraId="42CC87A3" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>a. Camera &amp; Photo Library Access</w:t></w:r></w:p><w:p w14:paraId="3B7C4E62" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:bCs/></w:rPr><w:t>When you choose to submit pictures, we request permission to access your device's camera and/or photo library. We only access these features when you actively initiate a photo upload or submission.</w:t></w:r></w:p><w:p w14:paraId="2AD7DB19" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>b. Photo Data Use &amp; Storage</w:t></w:r></w:p><w:p w14:paraId="35FD0B39" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Submitted photos are stored securely on our servers.</w:t></w:r></w:p><w:p w14:paraId="47A46BF0" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Photos may be displayed within the app for product submissions, user profiles, or community features (as applicable).</w:t></w:r></w:p><w:p w14:paraId="09CDB50D" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>You retain ownership of your photos. By submitting a photo, you grant us a license to use, store, and display it as part of the Service.</w:t></w:r></w:p><w:p w14:paraId="33A7658D" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="7"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Photos are not used for any purpose other than what is described in this policy unless you explicitly consent.</w:t></w:r></w:p><w:p w14:paraId="37EFA40C" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>c. Photo Data Deletion</w:t></w:r></w:p><w:p w14:paraId="7F752152" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>If you delete your account or request deletion of specific photos, we will remove such photos from our active systems within a reasonable time-frame, unless retention is legally required or necessary for dispute resolution.</w:t></w:r></w:p><w:p w14:paraId="4B8C3323" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="006421FA"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="5C92925D" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>5. How We Share Your Information</w:t></w:r></w:p><w:p w14:paraId="7E05F304" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>We do not sell, rent, or trade your personal information. We may share information in the following circumstances:</w:t></w:r></w:p><w:p w14:paraId="4548DC9C" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>With Service Providers:</w:t></w:r><w:r><w:t xml:space="preserve"> Vendors who help us operate the Service (e.g., hosting, analytics, security).</w:t></w:r></w:p><w:p w14:paraId="174425C4" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>For Legal Reasons:</w:t></w:r><w:r><w:t xml:space="preserve"> If required by law, regulation, or valid legal request.</w:t></w:r></w:p><w:p w14:paraId="2C69828E" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="4"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Aggregate/Anonymized Data:</w:t></w:r><w:r><w:t xml:space="preserve"> We may share insights based on collective user behavior with third parties, but this data does not identify individual users.</w:t></w:r></w:p><w:p w14:paraId="66C25DD2" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="006421FA"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="49963221" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>6. Data Retention</w:t></w:r></w:p><w:p w14:paraId="220E0AF6" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>We retain your personal data only as long as needed to provide the Service, comply with legal obligations, resolve disputes, and enforce our agreements.</w:t></w:r></w:p><w:p w14:paraId="0FC73339" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="8"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Account Data: </w:t></w:r><w:r><w:t xml:space="preserve">Retained for the duration of your account and for </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">180 Days </w:t></w:r><w:r><w:t>after deletion.</w:t></w:r></w:p><w:p w14:paraId="6804B97E" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="8"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Location Data:</w:t></w:r><w:r><w:t xml:space="preserve"> Retained for </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">180 Days </w:t></w:r><w:r><w:t>unless you request earlier deletion.</w:t></w:r></w:p><w:p w14:paraId="184D01EC" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="8"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>Photos/User Content:</w:t></w:r><w:r><w:t xml:space="preserve"> Retained until you delete your account or request removal.</w:t></w:r></w:p><w:p w14:paraId="5D4F8AD5" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>If you delete your account, we will delete or anonymize your personal data within a reasonable period unless retention is legally required.</w:t></w:r></w:p><w:p w14:paraId="4F8DEDE3" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="006421FA"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr></w:p><w:p w14:paraId="12EBF582" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>7. Security</w:t></w:r></w:p><w:p w14:paraId="0136401E" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>We use reasonable technical and organizational safeguards (such as encryption and limited access controls) to protect your personal information, including location data and submitted photos.</w:t></w:r><w:r><w:br/><w:t xml:space="preserve">However, no system is completely secure, and we cannot guarantee absolute security. You are responsible for maintaining the confidentiality of your account credentials. </w:t></w:r></w:p><w:p w14:paraId="194661BE" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="006421FA"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="3C207B42" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>8. Your Rights</w:t></w:r></w:p><w:p w14:paraId="45257206" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Depending on applicable law (including Jamaica’s Data Protection Act), you may have the right to:</w:t></w:r></w:p><w:p w14:paraId="489426A6" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Access and request a copy of the personal data we hold about you.</w:t></w:r></w:p><w:p w14:paraId="769B794E" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Request correction or deletion of your personal data, including location history and submitted photos.</w:t></w:r></w:p><w:p w14:paraId="45899EB8" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Object to or restrict certain types of processing, including location-based recommendations.</w:t></w:r></w:p><w:p w14:paraId="4B9ADC93" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Withdraw consent where processing is based on consent (e.g., disabling location services).</w:t></w:r></w:p><w:p w14:paraId="0F0CC42E" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="5"/></w:numPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>Lodge a complaint with the Jamaican Information Commissioner if you believe your data rights have been violated.</w:t></w:r></w:p><w:p w14:paraId="77CEC4D7" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t xml:space="preserve">To exercise these rights, contact us at </w:t></w:r><w:hyperlink r:id="rId5"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/><w:b/><w:bCs/></w:rPr><w:t>support@deferojamaica.com</w:t></w:r></w:hyperlink><w:r><w:t>. We may verify your identity before fulfilling requests.</w:t></w:r></w:p><w:p w14:paraId="52626BC8" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="006421FA"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2F364DCE" w14:textId="77777777" w:rsidR="001865A5" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="24CDC547" w14:textId="3AAA3815" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>9. Children’s Privacy</w:t></w:r></w:p><w:p w14:paraId="051604AC" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>The Service is not intended for children under 18. We do not knowingly collect personal information from individuals under this age. If we learn we have inadvertently collected such information, we will delete it.</w:t></w:r></w:p><w:p w14:paraId="38BDDFB9" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>10. International Users</w:t></w:r></w:p><w:p w14:paraId="673CA09C" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>Although the Service is operated from Jamaica, data may be stored or processed in other jurisdictions by our service providers. By using the Service, you consent to such transfers, which will be done in compliance with applicable data protection laws.</w:t></w:r></w:p><w:p w14:paraId="1BEA69CC" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="006421FA"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0AE98AE2" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>11. Changes to This Policy</w:t></w:r></w:p><w:p w14:paraId="3C81B66D" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>We may update this Privacy Policy from time to time. Any material changes will be posted in the app or on our website, with an updated “Last Updated” date. Your continued use of the Service indicates acceptance of the revised policy.</w:t></w:r></w:p><w:p w14:paraId="57404186" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="006421FA"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr></w:p><w:p w14:paraId="571E87EC" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>12. Contact Us</w:t></w:r></w:p><w:p w14:paraId="49514532" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:t>If you have questions or concerns about this Privacy Policy or our data practices, please contact us at:</w:t></w:r></w:p><w:p w14:paraId="4DD86E8C" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Email:</w:t></w:r><w:r><w:t xml:space="preserve"> info@</w:t></w:r><w:hyperlink r:id="rId6"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr><w:t>deferojamaica.com</w:t></w:r></w:hyperlink></w:p><w:p w14:paraId="0315D378" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:spacing w:line="240" w:lineRule="auto"/><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Phone:</w:t></w:r><w:r><w:t xml:space="preserve"> 1+ 876-631-7096</w:t></w:r></w:p><w:p w14:paraId="775E5791" w14:textId="77777777" w:rsidR="006421FA" w:rsidRDefault="001865A5"><w:pPr><w:spacing w:line="240" w:lineRule="auto"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t>Support Email</w:t></w:r><w:r><w:t xml:space="preserve">: </w:t></w:r><w:hyperlink r:id="rId7"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr><w:t>support@deferojamaica.com</w:t></w:r></w:hyperlink></w:p><w:p w14:paraId="79523FA0" w14:textId="77777777" w:rsidR="00642